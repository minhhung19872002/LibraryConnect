{
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.File"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
        "Hangfire": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/libraryconnect-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 90,
          "formatter": "Serilog.Formatting.Compact.CompactJsonFormatter, Serilog.Formatting.Compact"
        }
      }
    ]
  },
  "Jwt": {
    "Issuer": "LibraryConnect",
    "Audience": "LibraryConnect",
    "AccessTokenMinutes": 60,
    "RefreshTokenDays": 30
  },
  "Redis": {
    "ConnectionString": "localhost:6379",
    "KeyPrefix": "lc:",
    "DefaultTtlMinutes": 30,
    "Enabled": true
  },
  "ClamAv": {
    "Enabled": false,
    "Host": "clamav",
    "Port": 3310,
    "TimeoutSeconds": 60
  },
  "Minio": {
    "Endpoint": "localhost:9000",
    "UseSsl": false,
    "DocumentsBucket": "lc-documents",
    "ImagesBucket": "lc-images",
    "BackupsBucket": "lc-backups"
  },
  "Smtp": {
    "Port": 587,
    "UseSsl": true,
    "FromName": "LibraryConnect",
    "Enabled": false
  },
  "Backup": {
    "Directory": "/var/lib/libraryconnect/backups",
    "PgDumpPath": "pg_dump",
    "PgRestorePath": "pg_restore",
    "PsqlPath": "psql",
    "KeepCount": 30,
    "ScheduleCron": "0 2 * * *",
    "AutoEnabled": true,
    "IncludeObjectStorage": true
  },
  "Swagger": {
    "Enabled": true
  },
  "Database": {
    "AutoMigrate": true
  },
  "AllowedHosts": "*"
}

# =============================================================================
# LibraryConnect — biến môi trường
# Sao chép file này thành `.env` rồi sửa các giá trị đánh dấu (BẮT BUỘC ĐỔI).
# Mọi biến của backend đều mang tiền tố LC_.
# =============================================================================

# ---- Thông tin chung ------------------------------------------------------
COMPOSE_PROJECT_NAME=libraryconnect
TZ=Asia/Ho_Chi_Minh

# ---- PostgreSQL 16 --------------------------------------------------------
POSTGRES_DB=libraryconnect
POSTGRES_USER=libraryconnect
# BẮT BUỘC ĐỔI trước khi triển khai thật
POSTGRES_PASSWORD=libraryconnect
# Cổng mở ra máy chủ (đổi nếu cổng 5432 đã bị chiếm)
POSTGRES_PORT=5432

LC_DB_HOST=postgres
LC_DB_PORT=5432
LC_DB_NAME=libraryconnect
LC_DB_USER=libraryconnect
LC_DB_PASSWORD=libraryconnect

# ---- Redis 7 --------------------------------------------------------------
REDIS_PORT=6379
LC_Redis__ConnectionString=redis:6379
LC_Redis__KeyPrefix=lc:
LC_Redis__Enabled=true

# ---- MinIO (S3-compatible) ------------------------------------------------
MINIO_ROOT_USER=libraryconnect
# BẮT BUỘC ĐỔI, tối thiểu 8 ký tự
MINIO_ROOT_PASSWORD=libraryconnect
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

LC_Minio__Endpoint=minio:9000
LC_Minio__AccessKey=libraryconnect
LC_Minio__SecretKey=libraryconnect
LC_Minio__UseSsl=false
LC_Minio__DocumentsBucket=lc-documents
LC_Minio__ImagesBucket=lc-images
LC_Minio__BackupsBucket=lc-backups

# ---- Bảo mật --------------------------------------------------------------
# BẮT BUỘC ĐỔI. Tối thiểu 32 ký tự ngẫu nhiên.
# Sinh nhanh: openssl rand -base64 48
LC_Jwt__Secret=doi-gia-tri-nay-thanh-chuoi-ngau-nhien-toi-thieu-32-ky-tu
LC_Jwt__Issuer=LibraryConnect
LC_Jwt__Audience=LibraryConnect
LC_Jwt__AccessTokenMinutes=60
LC_Jwt__RefreshTokenDays=30

# Danh sách origin được phép gọi API, ngăn cách bằng dấu phẩy.
# Thêm origin của ứng dụng di động ở đợt phát triển sau.
LC_CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost

# ---- Email (tùy chọn) -----------------------------------------------------
LC_Smtp__Enabled=false
LC_Smtp__Host=
LC_Smtp__Port=587
LC_Smtp__UseSsl=true
LC_Smtp__Username=
LC_Smtp__Password=
LC_Smtp__FromAddress=
LC_Smtp__FromName=LibraryConnect

# ---- Sao lưu --------------------------------------------------------------
LC_Backup__Directory=/var/lib/libraryconnect/backups
LC_Backup__KeepCount=30
LC_Backup__ScheduleCron=0 2 * * *
LC_Backup__AutoEnabled=true
LC_Backup__IncludeObjectStorage=true

# ---- Giới hạn tần suất ----------------------------------------------------
# Số lần đăng nhập tối đa mỗi phút tính theo địa chỉ IP. Nếu toàn thư viện đi ra
# Internet qua một địa chỉ NAT duy nhất, hãy tăng giá trị này cho phù hợp số cán bộ.
LC_RateLimit__LoginPerMinute=20
# Số yêu cầu tối đa mỗi phút cho nhóm endpoint công khai (OPAC, ứng dụng di động).
LC_RateLimit__PublicPerMinute=300

# ---- API ------------------------------------------------------------------
API_PORT=8080
LC_Swagger__Enabled=true
LC_Database__AutoMigrate=true
ASPNETCORE_ENVIRONMENT=Production

# ---- Frontend -------------------------------------------------------------
# URL API mà trình duyệt gọi tới (qua Nginx). Được nhúng lúc build ảnh SPA.
VITE_API_BASE_URL=/api
ADMIN_PORT=5174
OPAC_PORT=5173

# ---- Nginx ----------------------------------------------------------------
HTTP_PORT=80
HTTPS_PORT=443
